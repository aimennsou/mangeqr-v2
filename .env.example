# =============================================================================
# MangeQR — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable below is actually read somewhere in the codebase.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL — Neon)
# Used by: prisma/schema.prisma datasource, lib/db.ts
# Get this from your Neon dashboard. Include `?sslmode=require`.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# Auth (NextAuth v5 / Auth.js)
# AUTH_SECRET: required. Generate with `npx auth secret` or `openssl rand -base64 32`.
# AUTH_URL: the app's base URL. Used by NextAuth and the email templates
#           (components/emails/*, lib/mail.ts) and app/layout.tsx metadata.
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public base URL used to build the diner-facing QR link (qrUrl -> /restaurant/[id]).
# Used by: app/api/magasin/route.ts. Should match your deployed origin in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Apex domain that hosts diner menus as subdomains, e.g. "mangeqr.com" so a
# restaurant "artisto" is reachable at artisto.mangeqr.com.
# Used by: lib/subdomain.ts + middleware.ts. LEAVE UNSET (or "localhost") in
# local dev — subdomain routing is then inert and menus use the path-based
# /restaurant/[id] link. Set it to your real apex domain in production, and
# configure wildcard DNS (*.mangeqr.com) + your host to route wildcard traffic
# to this app (see LOCAL_DEV.md "Production: subdomain routing").
NEXT_PUBLIC_ROOT_DOMAIN=""

# -----------------------------------------------------------------------------
# OAuth providers (optional — only needed if you enable social sign-in)
# Used by: auth.config.ts
# NOTE: the GitLab provider currently reuses the GITHUB_* values in code.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email (Resend)
# Used by: lib/mail.ts (auth emails), actions/send-email.ts (contact form),
#          app/api/campaign/send/route.ts (marketing campaigns)
# Get an API key at https://resend.com. The `from` addresses use @mangeqr.com,
# so you'll need a verified sending domain (or change the from-addresses in code).
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# File storage (AWS S3 — region eu-central-1)
# Used by: lib/s3.ts, lib/s3-server.ts (cover photos, dish photos)
# These are NEXT_PUBLIC_* because the browser-side upload helper reads them.
# Prefer scoping the IAM user to a single bucket with minimal permissions.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_S3_ACCESS_KEY_ID=""
NEXT_PUBLIC_S3_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_S3_BUCKET_NAME=""

# -----------------------------------------------------------------------------
# Stripe (subscription billing, EUR). Leave blank to keep the cash/contact
# path only — the app degrades gracefully when Stripe isn't configured.
# Server secret (sk_test_… / sk_live_…) + publishable key (pk_…):
STRIPE_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISH_KEY=""
# Webhook signing secret from `stripe listen` (dev) or the Dashboard endpoint:
STRIPE_WEBHOOK_SECRET=""
# Recurring EUR Price ids — generate with: node scripts/stripe-setup.mjs
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""

# -----------------------------------------------------------------------------
# Seed accounts — ALL FOUR ARE REQUIRED by prisma/seed.ts
#
# The seed has NO built-in credentials and exits with an error if any of these
# is missing or if a password is shorter than 12 characters. It used to ship
# working defaults, which meant anyone with repo access could seed themselves a
# full-privilege account.
#
# SUPERADMIN_*  the /superadmin console login: manages cash subscriptions,
#               suspends accounts, removes users. Owns no restaurants.
# DEMO_*        the account used to show the product to clients. Gets two demo
#               restaurants, menus, tables, 30 days of orders and analytics.
#
# The seed re-asserts both passwords on every run, so these values ARE the
# accounts' passwords — changing a password in the app is undone by the next
# seed. Generate them, don't type them: `openssl rand -base64 24`.
#
# Seeding production:  npm run db:seed:prod
#   Touches only these two accounts plus the demo account's own restaurants.
# Seeding locally:     npm run db:seed
#   DELETES EVERY restaurant in the database. Refuses to run against a
#   non-localhost DATABASE_URL unless you pass --force-dev-reset.
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
DEMO_EMAIL=""
DEMO_PASSWORD=""
