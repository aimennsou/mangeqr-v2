# =============================================================================
# MangeQR database (self-hosted PostgreSQL on a Debian VPS)
# Copy to `.env` on the VPS and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- Superuser / database -----------------------------------------------------
# The Postgres superuser the container is created with. The app does NOT use
# this account directly in production — use the least-privilege app role below.
POSTGRES_USER=mangeqr
# REQUIRED. Generate a strong one: `openssl rand -base64 32`
POSTGRES_PASSWORD=
POSTGRES_DB=mangeqr
POSTGRES_PORT=5432

# Interface the container port binds to on the HOST.
#   127.0.0.1  (default) — only reachable from the VPS itself. Run the app on
#              the same VPS and connect over localhost. SAFEST.
#   0.0.0.0    — reachable from other hosts. ONLY do this behind a firewall/VPN
#              and with SSL. Read README.md "Remote access" first.
POSTGRES_BIND=127.0.0.1

# --- Application role (least privilege) --------------------------------------
# A dedicated role the Next.js app connects as (created by init/02-app-role.sh).
# It owns the schema it needs but is NOT a superuser. Prisma migrate/db push
# works fine with it because it owns the public schema objects.
APP_DB_USER=mangeqr_app
# REQUIRED. Generate: `openssl rand -base64 32`
APP_DB_PASSWORD=

# --- The connection string the Next.js app uses ------------------------------
# This is what goes into the APP's .env as DATABASE_URL. Shown here so you can
# copy it. For a same-VPS app use localhost; sslmode=disable is fine over the
# loopback. For remote/SSL see README.md.
#
#   DATABASE_URL="postgresql://mangeqr_app:APP_DB_PASSWORD@localhost:5432/mangeqr?schema=public&sslmode=disable"
#
# (Neon required ?sslmode=require; a local VPS connection over 127.0.0.1 does
#  not need TLS. If you expose it remotely, switch to sslmode=require + a cert.)

# --- Backups ------------------------------------------------------------------
# Daily pg_dump retention (days) and the time of day (UTC, HH:MM) it runs.
BACKUP_RETENTION_DAYS=7
BACKUP_AT=03:00

# --- pgAdmin (optional, only with `--profile admin`) -------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
