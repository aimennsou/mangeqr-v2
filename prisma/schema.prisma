generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  SUPERADMIN
}

enum Plan {
  STARTER
  PRO
  PREMIUM
}

enum PlanPaymentMethod {
  CASH
  ONLINE
}

enum WorkspaceRole {
  OWNER
  MEMBER
}


model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String?
  email                   String?                 @unique
  tempEmail               String?
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    UserRole                @default(USER)
  plan                    Plan                    @default(STARTER)
  planPaymentMethod       PlanPaymentMethod       @default(CASH)
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  planRenewsAt            DateTime?
  suspended               Boolean                 @default(false)
  suspendedAt             DateTime?
  suspendedReason         String?
  // FEAT-1/D16: ordering is enabled per ACCOUNT by the SUPERADMIN. Owners can
  // then toggle it per restaurant (Restaurant.orderingEnabled). Defaults off so
  // ordering is opt-in and centrally gated.
  orderingEnabled         Boolean                 @default(false)
  accounts                Account[]
  isTwoFactorEnabled      Boolean                 @default(false)
  twoFactorConfirmation   TwoFactorConfirmation?
    restaurants     Restaurant[]
  ownedMemberships   Membership[] @relation("WorkspaceOwner")
  memberOf           Membership?  @relation("WorkspaceMember")
  invitationsCreated Invitation[] @relation("InvitationOwner")
  designOrders       DesignOrder[]
}

model Membership {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @db.Uuid
  memberUserId String        @unique @db.Uuid
  role         WorkspaceRole @default(MEMBER)
  createdAt    DateTime      @default(now())
  owner        User          @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  member       User          @relation("WorkspaceMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}

model Invitation {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @db.Uuid
  code         String        @unique
  role         WorkspaceRole @default(MEMBER)
  expiresAt    DateTime?
  usedByUserId String?       @db.Uuid
  usedAt       DateTime?
  createdAt    DateTime      @default(now())
  owner        User          @relation("InvitationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}




      model Account {
        id                 String   @id @default(uuid()) @db.Uuid
        userId             String @db.Uuid
        type               String
        provider           String
        providerAccountId  String
        refresh_token      String?  @db.Text
        access_token       String?  @db.Text
        expires_at         Int?
        token_type         String?
        scope              String?
        id_token           String?  @db.Text
        session_state      String?

        user User @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@unique([provider, providerAccountId])
      }

      model VerificationToken {
        id              String    @id @default(uuid()) @db.Uuid
        userId          String
        token           String    @unique
        isUpdateEmail   Boolean   @default(false)
        expires         DateTime

        @@unique([userId, token])
      }

      model PasswordResetToken {
        id        String    @id @default(uuid()) @db.Uuid
        email     String
        token     String    @unique
        expires   DateTime

        @@unique([email, token])
      }

      model TwoFactorToken {
        id        String    @id @default(uuid()) @db.Uuid
        email     String
        token     String    @unique
        expires   DateTime

        @@unique([email, token])
      }

      model TwoFactorConfirmation {
        id      String  @id @default(uuid()) @db.Uuid
        userId  String @db.Uuid
        user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@unique([userId])
      }






model Restaurant {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  address        String
  phone          String
  coverPhoto     String?
  qrUrl          String?
  wifi           String?
  subdomain      String?       @unique
  currency       Currency      @default(EURO)
  website        String?
  instagram      String?
  tiktok         String?
  google         String?
  wifistate      Settings      @default(ACTIVE)
  websitestate   Settings      @default(ACTIVE)
  instagramstate Settings      @default(ACTIVE)
  tiktokstate    Settings      @default(ACTIVE)
  googlestate    Settings      @default(ACTIVE)
  menuAppearance Json?
  // FEAT-1/D9: per-restaurant ordering on/off toggle (only effective when the
  // account is ordering-enabled by the superadmin — see User.orderingEnabled).
  orderingEnabled Boolean      @default(false)
  menus          Menu[]
  campaigns      MarketingCampaign[]
  reviews        Review[]
  scans          ScanData[]
  categoryData   CategoryData[]
  dishData       DishData[]
  favoriteData   FavoriteData[]
  designOrders   DesignOrder[]
  zones          TableZone[]
  tables         RestaurantTable[]
  orders         Order[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Menu {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  position      Int
  availability  String[]
  state         MenuState     @default(ACTIVE)
  categories    MenuCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MenuCategory {
  id            String        @id @default(uuid()) @db.Uuid
  menuId        String        @db.Uuid
  menu          Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  state         CatState      @default(ACTIVE)
  position      Int
  name          String
  logo          String?
  dishes        Dish[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Dish {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @db.Uuid
  category      MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  state         DishState     @default(ACTIVE)
  position      Int
  name          String
  description   String?
  photo         String?
  price         Float
  allergenes    String[]
  // FEAT-1/D12: owner-defined add-on groups (single/multi-select) for ordering.
  addonGroups   DishAddonGroup[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Review {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clientNumero  String?
  clientEmail   String?
  review        Float
  message       String?
  state         ReviewState   @default(MANGEQR)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MarketingCampaign {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  subject       String
  body          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sent          Boolean       @default(false)
  sentAt        DateTime?
  emailRecipients EmailRecipient[]
}

model EmailRecipient {
  id            String        @id @default(uuid()) @db.Uuid
  campaignId    String        @db.Uuid
  campaign      MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  createdAt     DateTime      @default(now())
}

model ScanData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model CategoryData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model DishData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId        String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

// One row per "favorite" click by a diner on a dish (heart button). Counted to
// surface the owner's most-favorited dish ("Le plat favoris" KPI).
model FavoriteData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId        String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, dishId])
}

model Newsletter {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  createdAt     DateTime      @default(now())
}

// A restaurateur's request to have a physical QR-code design produced (poster,
// engraved wood disc, table sticker, …). Scoped to the workspace owner (userId)
// and the restaurant whose menu the QR points to.
model DesignOrder {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId  String            @db.Uuid
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  designId      String            // references a product in config (DESIGN_PRODUCTS)
  designName    String            // denormalized label at order time
  quantity      Int               @default(1)
  contactName   String
  contactEmail  String
  contactPhone  String?
  deliveryMethod String?          // e.g. "yalidine-bureau" (Algeria) or standard/express
  notes         String?
  status        DesignOrderStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([restaurantId])
}

enum UserType {
  PRO
  PREMIUM
}

enum Currency {
  EURO
  DOLLAR
  DINAR
}

enum MenuState {
  ACTIVE
  INACTIVE
}

enum CatState {
  ACTIVE
  INACTIVE
}

enum DishState {
  ACTIVE
  INACTIVE
}

enum ReviewState {
  GOOGLE
  MANGEQR
}

enum Settings {
  ACTIVE
  INACTIVE
}

enum DesignOrderStatus {
  PENDING
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

// =============================================================================
// FEAT-2 — Table layout (zones + tables). Owner defines a drag-to-arrange floor
// plan per restaurant: named zones (e.g. Terrasse, Salle) and tables with a
// label/number, optional seat count, and x/y position on the plan.
// =============================================================================

model TableZone {
  id            String            @id @default(uuid()) @db.Uuid
  restaurantId  String            @db.Uuid
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  position      Int               @default(0)
  tables        RestaurantTable[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([restaurantId])
}

model RestaurantTable {
  id            String       @id @default(uuid()) @db.Uuid
  restaurantId  String       @db.Uuid
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Optional zone grouping (terrace / indoor / …). Null = unzoned.
  zoneId        String?      @db.Uuid
  zone          TableZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // Diner-facing label, usually a number ("7"). Unique per restaurant so the
  // diner's table pick is unambiguous.
  label         String
  seats         Int?
  // Position on the owner's floor-plan canvas (drag-to-arrange).
  posX          Float        @default(0)
  posY          Float        @default(0)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@index([zoneId])
}

// =============================================================================
// FEAT-1/D12 — Per-dish add-on groups. Each group is single- or multi-select
// (e.g. "Taille" single S/M/L, "Suppléments" multi cheese/bacon). Each option
// carries a priceDelta added to the line total when selected.
// =============================================================================

enum AddonGroupType {
  SINGLE
  MULTI
}

model DishAddonGroup {
  id          String           @id @default(uuid()) @db.Uuid
  dishId      String           @db.Uuid
  dish        Dish             @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name        String
  type        AddonGroupType   @default(SINGLE)
  // SINGLE groups may be required (diner must choose one). MULTI groups are
  // always optional in v1.
  required    Boolean          @default(false)
  position    Int              @default(0)
  options     DishAddonOption[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dishId])
}

model DishAddonOption {
  id          String          @id @default(uuid()) @db.Uuid
  groupId     String          @db.Uuid
  group       DishAddonGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  // Price added to the line when this option is selected (can be 0).
  priceDelta  Float           @default(0)
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([groupId])
}

// =============================================================================
// FEAT-1 — Diner orders. An order is placed from the public menu, either
// DINE_IN (attached to a table the diner picked) or DELIVERY (with contact +
// address or geolocation). Line items snapshot the dish name/price and the
// chosen add-ons (denormalized JSON) so historical orders stay accurate even if
// the menu changes later.
// =============================================================================

enum OrderType {
  DINE_IN
  DELIVERY
}

// Shared lifecycle covering both branches (D13b):
//   dine-in : RECEIVED → IN_PREPARATION → READY → SERVED → COMPLETED (+ CANCELLED)
//   delivery: RECEIVED → IN_PREPARATION → READY → OUT_FOR_DELIVERY → DELIVERED → COMPLETED (+ CANCELLED)
enum OrderStatus {
  RECEIVED
  IN_PREPARATION
  READY
  SERVED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

model Order {
  id            String           @id @default(uuid()) @db.Uuid
  restaurantId  String           @db.Uuid
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Per-restaurant incrementing order number for staff reference (e.g. #42).
  orderNumber   Int
  type          OrderType        @default(DINE_IN)
  status        OrderStatus      @default(RECEIVED)

  // Dine-in: the table the diner picked (kept even if the table is later
  // deleted, hence SetNull + denormalized label).
  tableId       String?          @db.Uuid
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel    String?

  // Delivery: customer contact + destination (address text and/or geolocation).
  customerName  String?
  customerPhone String?
  address       String?
  latitude      Float?
  longitude     Float?

  // Optional order-level note from the diner.
  note          String?

  // Denormalized total (sum of line totals) at submit time, in the restaurant's
  // currency. Recomputed server-side from menu prices — never trusted from the
  // client.
  total         Float            @default(0)

  // Payment tracking (pay-in-person). Staff mark an order paid from the
  // Commandes view / after printing the addition. `paidAt` stamps when.
  paid          Boolean          @default(false)
  paidAt        DateTime?

  items         OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableId])
}

model OrderItem {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @db.Uuid
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId        String    @db.Uuid
  // Snapshots so historical orders are stable if the menu changes.
  dishName      String
  unitPrice     Float
  quantity      Int       @default(1)
  // Chosen add-ons, denormalized as JSON:
  //   [{ groupName, optionName, priceDelta }]
  addons        Json?
  specialRequest String?
  // (unitPrice + sum(addon priceDelta)) * quantity, computed server-side.
  lineTotal     Float     @default(0)
  createdAt     DateTime  @default(now())

  @@index([orderId])
}