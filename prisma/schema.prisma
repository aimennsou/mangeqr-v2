generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  SUPERADMIN
}

enum Plan {
  STARTER
  PRO
  PREMIUM
}

enum PlanPaymentMethod {
  CASH
  ONLINE
}

enum WorkspaceRole {
  OWNER
  MEMBER
}


model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String?
  email                   String?                 @unique
  tempEmail               String?
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    UserRole                @default(USER)
  plan                    Plan                    @default(STARTER)
  planPaymentMethod       PlanPaymentMethod       @default(CASH)
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  planRenewsAt            DateTime?
  suspended               Boolean                 @default(false)
  suspendedAt             DateTime?
  suspendedReason         String?
  accounts                Account[]
  isTwoFactorEnabled      Boolean                 @default(false)
  twoFactorConfirmation   TwoFactorConfirmation?
    restaurants     Restaurant[]
  ownedMemberships   Membership[] @relation("WorkspaceOwner")
  memberOf           Membership?  @relation("WorkspaceMember")
  invitationsCreated Invitation[] @relation("InvitationOwner")
  designOrders       DesignOrder[]
}

model Membership {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @db.Uuid
  memberUserId String        @unique @db.Uuid
  role         WorkspaceRole @default(MEMBER)
  createdAt    DateTime      @default(now())
  owner        User          @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  member       User          @relation("WorkspaceMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}

model Invitation {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @db.Uuid
  code         String        @unique
  role         WorkspaceRole @default(MEMBER)
  expiresAt    DateTime?
  usedByUserId String?       @db.Uuid
  usedAt       DateTime?
  createdAt    DateTime      @default(now())
  owner        User          @relation("InvitationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}




      model Account {
        id                 String   @id @default(uuid()) @db.Uuid
        userId             String @db.Uuid
        type               String
        provider           String
        providerAccountId  String
        refresh_token      String?  @db.Text
        access_token       String?  @db.Text
        expires_at         Int?
        token_type         String?
        scope              String?
        id_token           String?  @db.Text
        session_state      String?

        user User @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@unique([provider, providerAccountId])
      }

      model VerificationToken {
        id              String    @id @default(uuid()) @db.Uuid
        userId          String
        token           String    @unique
        isUpdateEmail   Boolean   @default(false)
        expires         DateTime

        @@unique([userId, token])
      }

      model PasswordResetToken {
        id        String    @id @default(uuid()) @db.Uuid
        email     String
        token     String    @unique
        expires   DateTime

        @@unique([email, token])
      }

      model TwoFactorToken {
        id        String    @id @default(uuid()) @db.Uuid
        email     String
        token     String    @unique
        expires   DateTime

        @@unique([email, token])
      }

      model TwoFactorConfirmation {
        id      String  @id @default(uuid()) @db.Uuid
        userId  String @db.Uuid
        user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@unique([userId])
      }






model Restaurant {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  address        String
  phone          String
  coverPhoto     String?
  qrUrl          String?
  wifi           String?
  subdomain      String?       @unique
  currency       Currency      @default(EURO)
  website        String?
  instagram      String?
  tiktok         String?
  google         String?
  wifistate      Settings      @default(ACTIVE)
  websitestate   Settings      @default(ACTIVE)
  instagramstate Settings      @default(ACTIVE)
  tiktokstate    Settings      @default(ACTIVE)
  googlestate    Settings      @default(ACTIVE)
  menuAppearance Json?
  menus          Menu[]
  campaigns      MarketingCampaign[]
  reviews        Review[]
  scans          ScanData[]
  categoryData   CategoryData[]
  dishData       DishData[]
  favoriteData   FavoriteData[]
  designOrders   DesignOrder[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Menu {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  position      Int
  availability  String[]
  state         MenuState     @default(ACTIVE)
  categories    MenuCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MenuCategory {
  id            String        @id @default(uuid()) @db.Uuid
  menuId        String        @db.Uuid
  menu          Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  state         CatState      @default(ACTIVE)
  position      Int
  name          String
  logo          String?
  dishes        Dish[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Dish {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @db.Uuid
  category      MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  state         DishState     @default(ACTIVE)
  position      Int
  name          String
  description   String?
  photo         String?
  price         Float
  allergenes    String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Review {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clientNumero  String?
  clientEmail   String?
  review        Float
  message       String?
  state         ReviewState   @default(MANGEQR)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MarketingCampaign {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  subject       String
  body          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sent          Boolean       @default(false)
  sentAt        DateTime?
  emailRecipients EmailRecipient[]
}

model EmailRecipient {
  id            String        @id @default(uuid()) @db.Uuid
  campaignId    String        @db.Uuid
  campaign      MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  createdAt     DateTime      @default(now())
}

model ScanData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model CategoryData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model DishData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId        String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

// One row per "favorite" click by a diner on a dish (heart button). Counted to
// surface the owner's most-favorited dish ("Le plat favoris" KPI).
model FavoriteData {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @db.Uuid
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId        String        @db.Uuid
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, dishId])
}

model Newsletter {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  createdAt     DateTime      @default(now())
}

// A restaurateur's request to have a physical QR-code design produced (poster,
// engraved wood disc, table sticker, …). Scoped to the workspace owner (userId)
// and the restaurant whose menu the QR points to.
model DesignOrder {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId  String            @db.Uuid
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  designId      String            // references a product in config (DESIGN_PRODUCTS)
  designName    String            // denormalized label at order time
  quantity      Int               @default(1)
  contactName   String
  contactEmail  String
  contactPhone  String?
  deliveryMethod String?          // e.g. "yalidine-bureau" (Algeria) or standard/express
  notes         String?
  status        DesignOrderStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([restaurantId])
}

enum UserType {
  PRO
  PREMIUM
}

enum Currency {
  EURO
  DOLLAR
  DINAR
}

enum MenuState {
  ACTIVE
  INACTIVE
}

enum CatState {
  ACTIVE
  INACTIVE
}

enum DishState {
  ACTIVE
  INACTIVE
}

enum ReviewState {
  GOOGLE
  MANGEQR
}

enum Settings {
  ACTIVE
  INACTIVE
}

enum DesignOrderStatus {
  PENDING
  IN_PROGRESS
  SHIPPED
  CANCELLED
}